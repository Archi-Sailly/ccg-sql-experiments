{
  "base_model": "Qwen/Qwen2.5-Coder-7B-Instruct",
  "sft_adapter": "checkpoints/sft_schemaaug/final",
  "n_train": 249,
  "gspo_config": {
    "importance_sampling": "sequence",
    "dr_grpo_loss": true,
    "num_generations": 8,
    "max_prompt_length": 1024,
    "max_completion_length": 512,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "num_train_epochs": 3,
    "learning_rate": 1e-05,
    "kl_coef": 0.05,
    "temperature": 0.7,
    "top_p": 0.95,
    "bf16": true,
    "gradient_checkpointing": true
  },
  "reward": {
    "execution_timeout": 30,
    "lambda_construct": 0.2
  },
  "output_dir": "checkpoints/gspo_v2",
  "final_adapter": "checkpoints/gspo_v2/final",
  "use_4bit": false
}